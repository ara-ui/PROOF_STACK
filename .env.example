# All 11 variables below are read by src/config/env.ts (Phase 1/2 vars,
# plus Phase 3 auth config).

MONGO_URI=mongodb://localhost:27017/proofstack
REDIS_URL=redis://localhost:6379
PISTON_URL=http://localhost:2000

# Must match a runtime your self-hosted Piston instance actually has
# installed — check `GET {PISTON_URL}/api/v2/runtimes`. Both have defaults
# in src/config/env.ts (javascript / 18.15.0) if left unset.
PISTON_LANGUAGE=javascript
PISTON_VERSION=18.15.0

PORT=4000
NODE_ENV=development

# Phase 3 — required. Generate a real one yourself, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server refuses to start without a value at least 32 characters long.
JWT_SECRET=

# Optional — defaults shown, only override if you have a reason to.
JWT_ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
